# ---- Solr Sentinel configuration (copy to .env or export in your shell) ----
# Never commit .env. In production, inject these from a secrets manager.

# Deployment. production = refuse to start with unsafe settings (see docs/production-readiness.md)
SENTINEL_ENV=development
# text for local use; json in production (one JSON object per line, for the log platform)
SENTINEL_LOG_FORMAT=text

# API authentication. The dashboard sends the same key.
# Production: at least 24 random characters, e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
SENTINEL_API_KEY=change-me
SENTINEL_API_URL=http://127.0.0.1:8000

# Cluster / data
SENTINEL_CLUSTER_ID=solrcloud-prod-1
# <dir>/<node_id>/{solr*.log,gc*.log}
SENTINEL_LOG_DIR=./sample_data/logs
# data = judge replayed sample logs at their own time; wall = live collection (required in production)
SENTINEL_CLOCK=data
SENTINEL_ZK_CLIENT_TIMEOUT_MS=15000
SENTINEL_TELEMETRY_STALE_AFTER_S=300
SENTINEL_MAX_UPLOAD_MB=50

# Extra models re-analysis may request, comma-separated (the configured models are always allowed)
SENTINEL_LLM_ALLOWED_MODELS=

# ---- LLM provider. auto = first provider with a key; none = rules-based RCA only
LLM_PROVIDER=auto

# Production (default): Claude on AWS Bedrock in the client's account, via an IAM role (no API key).
# Add boto3 to requirements.txt and regenerate requirements.lock first.
# LLM_PROVIDER=bedrock
# AWS_REGION=eu-west-1
# BEDROCK_MODEL_ID=<claude-haiku-model-id-enabled-in-your-account>
# BEDROCK_MODEL_ID_STRONG=<claude-sonnet-model-id-enabled-in-your-account>

# Production via LLM gateway (LiteLLM, see deploy/litellm-config.yaml)
# LLM_PROVIDER=gateway
# LLM_BASE_URL=http://litellm:4000/v1
# LLM_API_KEY=<gateway virtual key>

# Production on-prem: self-hosted open model on vLLM
# LLM_PROVIDER=vllm
# LLM_BASE_URL=http://vllm:8000/v1
# LLM_MODEL=<served model name>

# Direct APIs (allowed in production)
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...

# Development only (refused when SENTINEL_ENV=production)
# GEMINI_API_KEY=...            free tier, uses gemini-3.8-flash
# GROQ_API_KEY=...              free tier
# LLM_PROVIDER=ollama           local; ollama pull qwen2.5:14b

# Optional cost tracking (USD per 1k tokens) for the sentinel_llm_cost_usd_total metric
# LLM_PRICE_IN_PER_1K=0.003
# LLM_PRICE_OUT_PER_1K=0.015
